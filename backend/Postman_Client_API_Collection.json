{
  "info": {
    "name": "API Client Bancaire",
    "description": "Collection complète pour tester l'authentification et les opérations bancaires des clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gestion Client",
      "item": [
        {
          "name": "Créer un client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('clientId', jsonData.id);",
                  "    pm.environment.set('clientId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jean\",\n  \"last_name\": \"Dupont\",\n  \"email\": \"jean.dupont@example.com\",\n  \"password\": \"MotDePasse123!\",\n  \"birth_date\": \"1990-05-15\",\n  \"gender\": \"M\",\n  \"address\": \"123 Rue de la Paix, Paris\",\n  \"phone_number\": \"+33612345678\",\n  \"nationality\": \"Française\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"]
            },
            "description": "Créer un nouveau client avec toutes les informations requises"
          },
          "response": []
        },
        {
          "name": "Créer un autre client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Marie\",\n  \"last_name\": \"Martin\",\n  \"email\": \"marie.martin@example.com\",\n  \"password\": \"SecurePass456!\",\n  \"birth_date\": \"1985-08-20\",\n  \"gender\": \"F\",\n  \"address\": \"456 Avenue des Champs, Lyon\",\n  \"phone_number\": \"+33687654321\",\n  \"nationality\": \"Française\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"]
            },
            "description": "Créer un deuxième client pour tester les virements"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentification",
      "item": [
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    pm.environment.set('token', jsonData.access_token);",
                  "    pm.collectionVariables.set('clientId', jsonData.user_id);",
                  "    pm.environment.set('clientId', jsonData.user_id);",
                  "    console.log('Token saved: ' + jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.dupont@example.com\",\n  \"password\": \"MotDePasse123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "auth", "login"]
            },
            "description": "Connexion du client - retourne un token JWT"
          },
          "response": []
        },
        {
          "name": "Mes informations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "auth", "me"]
            },
            "description": "Récupérer les informations du client connecté"
          },
          "response": []
        },
        {
          "name": "Login - Email incorrect",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@example.com\",\n  \"password\": \"MotDePasse123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "auth", "login"]
            },
            "description": "Test avec un email incorrect - doit retourner 401"
          },
          "response": []
        },
        {
          "name": "Login - Mot de passe incorrect",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.dupont@example.com\",\n  \"password\": \"WrongPassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "auth", "login"]
            },
            "description": "Test avec un mot de passe incorrect - doit retourner 401"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Comptes",
      "item": [
        {
          "name": "Voir tous mes comptes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set('accountId', jsonData[0].id);",
                  "        pm.environment.set('accountId', jsonData[0].id);",
                  "        console.log('Account ID saved: ' + jsonData[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts"]
            },
            "description": "Liste de tous les comptes du client connecté"
          },
          "response": []
        },
        {
          "name": "Voir un compte spécifique",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}"]
            },
            "description": "Détails d'un compte spécifique"
          },
          "response": []
        },
        {
          "name": "Accéder au compte d'un autre client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "999"]
            },
            "description": "Test de sécurité - doit retourner 403 Forbidden"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Opérations - Dépôt",
      "item": [
        {
          "name": "Dépôt - Succès",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00,\n  \"description\": \"Dépôt en espèces\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "deposit"]
            },
            "description": "Effectuer un dépôt sur le compte"
          },
          "response": []
        },
        {
          "name": "Dépôt - Sans description",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "deposit"]
            },
            "description": "Dépôt sans description (optionnel)"
          },
          "response": []
        },
        {
          "name": "Dépôt - Montant négatif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -100.00,\n  \"description\": \"Test montant négatif\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "deposit"]
            },
            "description": "Test avec montant négatif - doit retourner 400"
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Opérations - Retrait",
      "item": [
        {
          "name": "Retrait - Succès",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200.00,\n  \"description\": \"Retrait DAB\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "withdraw"]
            },
            "description": "Effectuer un retrait sur le compte"
          },
          "response": []
        },
        {
          "name": "Retrait - Solde insuffisant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999.00,\n  \"description\": \"Test solde insuffisant\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "withdraw"]
            },
            "description": "Test avec montant supérieur au solde - doit retourner 403"
          },
          "response": []
        },
        {
          "name": "Retrait - Montant zéro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 0,\n  \"description\": \"Test montant zéro\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "withdraw"]
            },
            "description": "Test avec montant zéro - doit retourner 400"
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Opérations - Virement",
      "item": [
        {
          "name": "Virement - Succès",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 300.00,\n  \"destination_account_number\": \"ACC-002-2024\",\n  \"description\": \"Remboursement prêt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "transfer"]
            },
            "description": "Effectuer un virement vers un autre compte"
          },
          "response": []
        },
        {
          "name": "Virement - Compte destination inexistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"destination_account_number\": \"ACC-INEXISTANT\",\n  \"description\": \"Test compte inexistant\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "transfer"]
            },
            "description": "Test avec compte destination inexistant - doit retourner 401"
          },
          "response": []
        },
        {
          "name": "Virement - Sans numéro de compte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"description\": \"Test sans compte destination\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "transfer"]
            },
            "description": "Test sans numéro de compte destination - doit retourner 400"
          },
          "response": []
        },
        {
          "name": "Virement - Solde insuffisant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999.00,\n  \"destination_account_number\": \"ACC-002-2024\",\n  \"description\": \"Test solde insuffisant\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "transfer"]
            },
            "description": "Test avec montant supérieur au solde - doit retourner 403"
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Historique et Relevés",
      "item": [
        {
          "name": "Historique des transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Toutes les transactions du compte"
          },
          "response": []
        },
        {
          "name": "Relevé bancaire - Défaut (1 mois)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/statement",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "statement"]
            },
            "description": "Relevé du dernier mois par défaut"
          },
          "response": []
        },
        {
          "name": "Relevé bancaire - Période spécifique",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/statement?startDate=2024-01-01&endDate=2024-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "statement"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2024-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-31"
                }
              ]
            },
            "description": "Relevé pour une période spécifique"
          },
          "response": []
        },
        {
          "name": "Relevé bancaire - Seulement date début",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/{{accountId}}/statement?startDate=2024-01-01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "{{accountId}}", "statement"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2024-01-01"
                }
              ]
            },
            "description": "Relevé depuis une date jusqu'à aujourd'hui"
          },
          "response": []
        }
      ]
    },
    {
      "name": "8. Tests de sécurité",
      "item": [
        {
          "name": "Sans token - Accès comptes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts"]
            },
            "description": "Test sans token - doit retourner 401"
          },
          "response": []
        },
        {
          "name": "Token invalide - Accès comptes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token_invalide_xyz123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts"]
            },
            "description": "Test avec token invalide - doit retourner 401"
          },
          "response": []
        },
        {
          "name": "Accès au compte d'un autre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"description\": \"Test sécurité\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/client/accounts/999/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "client", "accounts", "999", "deposit"]
            },
            "description": "Tentative de dépôt sur le compte d'un autre - doit retourner 403"
          },
          "response": []
        }
      ]
    }
  ]
}
